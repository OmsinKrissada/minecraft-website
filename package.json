{
  "name": "minecraft-website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "upload": "rsync -avzh dist/* minecraft@ubunsin:/var/www/minecraft"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@lottiefiles/lottie-player": "^2.0.12",
    "@vueuse/core": "^10.11.1",
    "@vueuse/head": "^2.0.0",
    "axios": "^1.18.0",
    "embla-carousel-vue": "8.0.2",
    "marked": "^12.0.2",
    "pinia": "^2.3.1",
    "vue": "^3.5.38",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@hcaptcha/vue3-hcaptcha": "^1.3.0",
    "@rushstack/eslint-patch": "^1.16.1",
    "@types/node": "^24",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.4.5",
    "vite": "^8.0.16",
    "vue-tsc": "^2.2.12"
  }
}